# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-sonnet-5

# Jira Cloud (API token: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_URL=https://yoursite.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=QA
# How `run.py jira-push` creates test cases
JIRA_TEST_ISSUE_TYPE=Task
JIRA_TEST_LABEL=ai-generated-test
JIRA_LINK_TYPE=Relates

# Confluence (same Atlassian site; /wiki is added automatically)
CONFLUENCE_URL=https://yoursite.atlassian.net
# CONFLUENCE_EMAIL defaults to JIRA_EMAIL
CONFLUENCE_TOKEN=your_confluence_api_token
CONFLUENCE_SPACE_KEY=PROD

# Paths
CODEBASE_PATH=./tests
TEST_RESULTS_PATH=./reports
CHROMA_DB_PATH=./chroma_db

# API
API_HOST=0.0.0.0
API_PORT=8000
